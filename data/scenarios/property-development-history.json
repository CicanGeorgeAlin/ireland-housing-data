  },
  "guardrails":[
    "Do not fill gaps in the timeline with assumptions.",
    "A planning event does not prove construction occurred.",
    "A building-control record does not by itself establish title ownership.",
    "A current folio does not automatically establish every historical ownership event.",
    "Physical changes should be distinguished from legally documented changes.",
    "Historical law must be resolved at the date of each event.",
    "Conflicting source dates remain visible rather than silently reconciled."
  ],
  "result_types":[
