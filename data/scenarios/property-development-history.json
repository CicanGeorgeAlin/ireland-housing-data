    "change_of_use",
    "enforcement_or_retention_event",
    "easement_or_right_registration",
    "co_ownership_change",
    "succession_event",
    "sale_or_transfer",
    "mortgage_release",
    "current_registered_state"
  ],
  "pipeline":[
    "identify-property",
    "set-date-range",
    "collect-title-events",
    "collect-planning-events",
    "collect-building-control-events",
