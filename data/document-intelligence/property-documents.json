{
  "id":"property-document-intelligence",
  "version":"0.1",
  "verified_on":"2026-09-23",
  "status":"CROSS_DOMAIN_DOCUMENT_ENGINE",
  "purpose":"Identify, extract, reconcile and legally contextualise uploaded property documents without treating extraction as legal determination.",
  "document_types":[
    "FOLIO",
    "TITLE_PLAN",
    "FILED_INSTRUMENT",
    "DEED",
    "CONVEYANCE",
    "TRANSFER",
    "LEASE",
    "MORTGAGE",
    "CHARGE",
    "DISCHARGE_OR_RELEASE",
    "EASEMENT_DOCUMENT",
    "PLANNING_PERMISSION",
    "PLANNING_APPLICATION",
    "PLANNING_DECISION",
    "COMMENCEMENT_NOTICE",
    "SEVEN_DAY_NOTICE",
    "CERTIFICATE_OF_COMPLIANCE_ON_COMPLETION",
    "FIRE_SAFETY_CERTIFICATE",
    "OMC_CONSTITUTION",
    "OMC_MINUTES",
    "SERVICE_CHARGE_DEMAND",
    "INSURANCE_POLICY",
    "INSURANCE_CLAIM_DOCUMENT",
    "TAX_CLEARANCE",
    "PROBATE_OR_ADMINISTRATION_DOCUMENT"
  ],
  "processing_pipeline":[
    "document_identity",
    "page_and_section_structure",
    "property_identifier_extraction",
    "party_and_entity_extraction",
    "date_extraction",
    "folio_and_reference_extraction",
    "legal_interest_extraction",
    "obligation_right_and_condition_extraction",
    "map_and_plan_reference_extraction",
    "cross_document_consistency_check",
    "source_verification",
    "legal_proposition_mapping",
    "missing_evidence_detection",
    "conflict_detection",
    "historical_version_detection"
  ],
  "evidence_states":[
    "MISSING",
    "SUPPLIED",
    "EXTRACTED",
    "CONSISTENT",
    "CONFLICT",
    "OFFICIAL_VERIFICATION_REQUIRED",
    "PROFESSIONAL_REVIEW_REQUIRED"
  ],
  "guardrails":[
    "OCR or text extraction is not proof of authenticity.",
    "A document's existence does not establish every assertion contained in it.",
    "Do not infer current legal effect from an undated or historical document without date analysis.",
    "Do not infer ownership from a deed without identifying execution, registration and relevant title context.",
    "Do not infer planning or building-control compliance from a title document.",
    "Do not infer insurance cover from a policy schedule without reviewing applicable wording and exclusions.",
    "Conflicting documents must remain visible and be escalated for legal/source review."
  ],
  "output_contract":[
    "WHAT_DOCUMENT_IS_THIS",
    "WHAT_FACTS_WERE_EXTRACTED",
    "WHAT_DOES_IT_ESTABLISH",
    "WHAT_DOES_IT_NOT_ESTABLISH",
    "WHAT_OTHER_DOCUMENTS_ARE_REQUIRED",
    "WHAT_CONFLICTS_EXIST",
    "WHAT_OFFICIAL_SOURCE_CAN_VERIFY_IT",
    "WHAT_LEGAL_PROPOSITIONS_IT_SUPPORTS",
    "LAST_VERIFIED"
  ]
}