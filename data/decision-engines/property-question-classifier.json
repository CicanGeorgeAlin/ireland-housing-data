    "PROPERTY_SCOPE",
    "TIME_SCOPE",
    "REGISTRATION_SYSTEM",
    "PROPERTY_INTEREST",
    "EVENT_TYPE",
    "EVIDENCE_TARGET",
    "LEGAL_ISSUE",
    "PROCEDURAL_TARGET"
  ],
