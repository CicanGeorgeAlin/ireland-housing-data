{
  "schema_version":"1.0",
  "engine_id":"property-question-classifier",
  "status":"STRUCTURALLY_ESTABLISHED",
  "verified_date":"2026-09-24",
  "purpose":"Convert a natural-language property question into structured decision inputs without prematurely deciding the legal answer.",
  "classification_dimensions":[
