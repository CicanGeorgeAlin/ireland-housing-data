    "RECTIFICATION",
    "COURT_ORDER",
    "DOCUMENT_INTERPRETATION",
    "PROPERTY_RECORD_RETRIEVAL",
    "GENERAL_PROPERTY_LAW"
  ],
  "time_scope_types":[
    "CURRENT",
    "EXACT_DATE",
    "DATE_RANGE",
