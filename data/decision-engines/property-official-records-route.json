{
  "id":"property-official-records-route",
  "version":"0.1",
  "verified_on":"2026-09-23",
  "status":"SOURCE_VERIFIED_ROUTE_SEED",
  "question":"Which official property record should be obtained?",
  "route_logic":[
    {
      "need":"IDENTIFY_REGISTERED_PROPERTY",
      "route":"LANDDIRECT_MAP_SEARCH",
      "output":"folio_reference_if_registered",
      "source":"Tailte Éireann"
    },
    {
      "need":"CURRENT_REGISTERED_TITLE",
      "route":"LANDDIRECT_FOLIO",
      "output":"plain_or_certified_folio",
      "source":"Tailte Éireann"
    },
    {
      "need":"TITLE_PLAN",
      "route":"LANDDIRECT_FOLIO_AND_TITLE_PLAN",
      "output":"folio_plus_title_plan",
      "source":"Tailte Éireann"
    },
    {
      "need":"OFFICIAL_OWNERSHIP_SEARCH",
      "route":"LR_FORM_89",
      "output":"official_search_result",
      "source":"Tailte Éireann Rule 160"
    },
    {
      "need":"HISTORICAL_REGISTER_ENTRIES",
      "route":"LR_FORM_90",
      "output":"official_search_for_entries",
      "source":"Tailte Éireann Rule 160"
    },
    {
      "need":"UNREGISTERED_PROPERTY_OR_HISTORICAL_DEEDS",
      "route":"REGISTRY_OF_DEEDS_SEARCH",
      "output":"official_search_or_record_copy",
      "source":"Tailte Éireann"
    },
    {
      "need":"UNDERLYING_FILED_INSTRUMENT",
      "route":"INSTRUMENT_COPY_ROUTE",
      "output":"filed_instrument_if_available",
      "source":"Tailte Éireann"
    }
  ],
  "critical_distinctions":[
    "A Land Registry map search identifies whether property is registered and can identify a folio; it is not itself proof of every legal interest.",
    "A folio is evidence of the registered title position but does not automatically answer every historical or physical-boundary question.",
    "A Registry of Deeds search discloses whether documents have been executed; the legal effect of the deeds requires examination of the deeds themselves.",
    "Current records and historical records are separate retrieval problems.",
    "The website must never claim that a record was retrieved unless an actual official record was retrieved and evidence-linked."
  ],
  "result_types":[
    "FOLIO_ROUTE",
    "TITLE_PLAN_ROUTE",
    "OFFICIAL_SEARCH_ROUTE",
    "HISTORICAL_ENTRY_ROUTE",
    "REGISTRY_OF_DEEDS_ROUTE",
    "INSTRUMENT_ROUTE",
    "PROPERTY_IDENTIFIER_REQUIRED",
    "REGISTRATION_STATUS_UNKNOWN",
    "NOT_DETERMINABLE"
  ]
}