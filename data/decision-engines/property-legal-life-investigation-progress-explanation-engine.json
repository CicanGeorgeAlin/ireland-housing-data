{
  "schema_version":"1.0",
  "engine_id":"property-legal-life-investigation-progress-explanation-engine",
  "status":"STRUCTURALLY_ESTABLISHED",
  "verified_date":"2026-09-24",
  "purpose":"Translate internal investigation state into a clear citizen-facing explanation of progress, established material points, current work, blockers and next steps without exposing internal reasoning.",
  "core_principle":"WHERE WE ARE → WHAT IS ESTABLISHED → WHAT IS BEING CHECKED → WHAT IS WAITING → WHAT HAPPENS NEXT",
  "progress_sections":[
    "CURRENT_STAGE",
    "WHAT_WE_UNDERSTAND",
    "WHAT_HAS_BEEN_ESTABLISHED",
    "WHAT_IS_BEING_CHECKED",
    "WHAT_IS_WAITING",
    "MATERIAL_LIMITATIONS",
    "WHAT_WE_NEED_FROM_YOU_IF_ANY",
    "NEXT_STEP",
    "ANSWER_STATUS"
  ],
  "internal_to_citizen_mapping":{
    "QUESTION_UNRESOLVED":"Question understood / clarification needed",
    "PROPERTY_UNRESOLVED":"Property information needed",
    "DATE_SCOPE_UNRESOLVED":"Date or period needed",
    "EVIDENCE_REQUIRED":"Evidence needed",
    "EVIDENCE_RETRIEVAL_IN_PROGRESS":"Evidence being checked",
    "SOURCE_RECEIVED":"Evidence received",
    "PROPERTY_MATCH_INCOMPLETE":"Property identity being checked",
    "DATE_MATCH_INCOMPLETE":"Date being checked",
    "FACTS_ESTABLISHED":"Material facts established",
    "LEGAL_ANALYSIS_REQUIRED":"Law being checked",
    "LEGAL_ANALYSIS_INCOMPLETE":"Legal analysis being checked",
    "CONFLICT_DETECTED":"Conflicting information being reviewed",
    "MORE_EVIDENCE_REQUIRED":"More evidence needed",
    "PROCEDURE_IDENTIFIED":"Next official route identified",
    "DEADLINE_IDENTIFIED":"Deadline checked",
    "QUALITY_GATE_REQUIRED":"Answer under review",
    "READY_TO_PUBLISH":"Answer ready",
    "PUBLISHED":"Answer published",
    "REQUIRES_REVERIFICATION":"Answer requires re-check",
    "BLOCKED":"Temporarily blocked"
  },
  "progress_sequence":[
    "LOAD_INVESTIGATION_STATE",
    "LOAD_CITIZEN_TIMELINE_STATE",
    "SELECT_CURRENT_STAGE",
    "SELECT_MATERIAL_ESTABLISHED_POINTS",
    "SELECT_CURRENT_WORK",
    "SELECT_BLOCKERS",
    "SELECT_CITIZEN_ACTION_IF_REQUIRED",
    "SELECT_NEXT_STAGE",
    "CHECK_PRIVACY",
    "CHECK_NO_INTERNAL_REASONING",
    "RENDER_PROGRESS_EXPLANATION"
  ],
  "rules":[
    "Progress describes actual recorded state, not estimated completion.",
    "Only material established facts are shown as established.",
    "Internal engine names, confidence scores and chain-of-thought are never exposed.",
    "Waiting states identify the action or evidence needed when safe to do so.",
    "A progress explanation does not itself establish a property or legal fact.",
    "The citizen's original scope is preserved.",
    "Historical and current investigations remain distinct.",
    "No unsupported timing estimate is displayed."
  ],
  "progress_states":[
    "QUESTION_UNDERSTOOD",
    "INFORMATION_NEEDED",
    "EVIDENCE_BEING_CHECKED",
    "PROPERTY_AND_DATE_CHECKED",
    "LAW_BEING_CHECKED",
    "CONFLICT_OR_GAP_REVIEWED",
    "NEXT_ROUTE_IDENTIFIED",
    "ANSWER_REVIEWED",
    "ANSWER_READY",
    "ANSWER_PUBLISHED",
    "WAITING_FOR_CITIZEN",
    "WAITING_FOR_OFFICIAL_EVIDENCE",
    "TEMPORARILY_BLOCKED",
    "REVIEW_REQUIRED"
  ],
  "hard_stops":[
    "Never invent progress that has not occurred.",
    "Never expose internal chain-of-thought or confidence.",
    "Never state that a fact is established merely because the investigation reached a later stage.",
    "Never give unsupported completion-time estimates.",
    "Never hide a material blocker.",
    "Never silently change the investigation scope."
  ],
  "output_contract":[
    "progress_id",
    "investigation_id",
    "current_stage",
    "understood_question",
    "established_points",
    "current_checks",
    "waiting_items",
    "limitations",
    "citizen_action",
    "next_step",
    "answer_status"
  ]
}